{
  "name": "@morphix/desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm build && wait-on http://127.0.0.1:5173 -t 120000 && electron .",
    "start": "electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.morphix.desktop",
    "productName": "Morphix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
